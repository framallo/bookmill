{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bookmill",
  "version": "0.1.0",
  "identifier": "io.framallo.bookmill",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "bookmill",
        "label": "main",
        "url": "index.html",
        "width": 1200,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "Federico Ramallo",
    "category": "Productivity",
    "shortDescription": "Native desktop UI for the bookmill publishing pipeline",
    "longDescription": "bookmill is a convention-over-configuration book-publishing CLI. This desktop app opens its library browser, cover editor and interior previewer in a native macOS window.",
    "copyright": "Copyright © 2026 Federico Ramallo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bookmill": "bookmill"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null,
      "exceptionDomain": ""
    }
  }
}
