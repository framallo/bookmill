<!doctype html><html><head><meta charset="utf-8">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{FONT_LINK}}" rel="stylesheet">
<style>
 @page{size:{{FULL_W}}in {{FULL_H}}in;margin:0}
 *{margin:0;padding:0;box-sizing:border-box}
 html,body{width:{{FULL_W}}in;height:{{FULL_H}}in;overflow:hidden}
 .wrap{position:relative;display:flex;width:{{FULL_W}}in;height:{{FULL_H}}in;background:{{BGCOLOR}}}
 .wrapbg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:{{FILT}};z-index:0}
 .panel{position:relative;height:{{FULL_H}}in;overflow:hidden;z-index:1}
 .backscrim{position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.5) 26%, rgba(0,0,0,0.5) 60%, rgba(0,0,0,0) 80%)}
 .back{flex:0 0 {{BACK_PCT}}%} .spine{flex:0 0 {{SPINE_PCT}}%} .front{flex:0 0 {{FRONT_PCT}}%}
 .front .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:{{FILT}}}
 .front .grad{position:absolute;inset:0;background:linear-gradient(180deg,
        rgba(0,0,0,0.26) 0%, rgba(0,0,0,0.04) 16%, rgba(0,0,0,0.0) 44%,
        rgba(0,0,0,0.0) 72%, rgba(0,0,0,0.06) 88%, rgba(0,0,0,0.16) 100%)}
 .front .content{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
        padding:0.55in 0.45in 0.5in;z-index:3}
 .badge{font-family:'Montserrat',sans-serif;font-size:13px;letter-spacing:4px;
        text-transform:uppercase;color:{{BADGE_COLOR}};opacity:0.95;
        -webkit-text-stroke:{{BADGE_STROKE}};paint-order:stroke fill}
 .titleblock{margin-top:7%;text-align:center;width:100%}
 .ftitle{font-family:'{{SERIF}}',serif;font-weight:800;font-size:{{FT_PX}}px;
        line-height:{{FT_LH}};color:{{TITLE_COLOR}};text-shadow:{{FT_SHADOW}};
        -webkit-text-stroke:{{FT_STROKE}};paint-order:stroke fill}
 .frule{height:2px;width:1.2in;background:{{ACCENT}};margin:0.18in auto 0;opacity:0.85}
 .fsub{font-family:'{{SUB_FONT}}',sans-serif;font-style:{{SUB_ITALIC}};font-size:18px;line-height:1.3;
        color:{{SUB_COLOR}};margin-top:0.14in;text-shadow:{{SUB_SHADOW}};
        -webkit-text-stroke:{{SUB_STROKE}};paint-order:stroke fill}
 .fauthor{margin-top:auto;font-family:'Montserrat',sans-serif;font-size:15px;letter-spacing:3px;
        text-transform:uppercase;color:{{AUTHOR_COLOR}};
        -webkit-text-stroke:{{AUTHOR_STROKE}};paint-order:stroke fill}
 .back{display:flex;flex-direction:column;align-items:center;padding:0.7in 0.55in 0.55in;
        background:{{BACK_BG}}}
 .back .bbadge,.back .bblurb,.back .bfoot{position:relative;z-index:2}
 .bbadge{font-family:'Montserrat',sans-serif;font-size:13px;letter-spacing:4px;
        text-transform:uppercase;color:{{BADGE_COLOR}};opacity:0.95;
        -webkit-text-stroke:{{BADGE_STROKE}};paint-order:stroke fill}
 .bblurb{margin-top:0.25in;margin-bottom:auto;font-family:'{{SERIF}}',serif;font-size:21px;
        line-height:1.55;color:{{BLURB_COLOR}};text-align:center;
        text-shadow:{{BLURB_SHADOW}};
        -webkit-text-stroke:{{BLURB_STROKE}};paint-order:stroke fill}
 .bfoot{align-self:flex-start;text-align:left;font-family:'Montserrat',sans-serif;font-size:13px;letter-spacing:3px;
        text-transform:uppercase;color:{{AUTHOR_COLOR}};opacity:0.85;
        -webkit-text-stroke:{{AUTHOR_STROKE}};paint-order:stroke fill}
 .spine{background:{{BACK_BG}};box-shadow:inset 3px 0 0 {{ACCENT}},inset -3px 0 0 {{ACCENT}};display:flex;align-items:center;justify-content:center}
 .spinetxt{writing-mode:vertical-rl;transform:rotate(180deg);
        font-family:'{{SERIF}}',serif;font-size:14px;letter-spacing:2px;color:{{TITLE_COLOR}};
        white-space:nowrap}
</style></head><body>
<div class="wrap">
 {{WRAPBG_IMG}}
 <div class="panel back">
   {{BACK_SCRIM}}
   <div class="bbadge">{{BADGE}}</div>
   <div class="bblurb">{{BLURB}}</div>
   <div class="bfoot">{{AUTHOR}}</div>
 </div>
 <div class="panel spine">{{SPINE_INNER}}</div>
 <div class="panel front">
   {{FRONT_BG}}
   <div class="grad"></div>
   <div class="content">
     <div class="badge">{{BADGE}}</div>
     <div class="titleblock">
       <div class="ftitle">{{TITLE_HTML}}</div>
       <div class="frule"></div>
       <div class="fsub">{{SUB}}</div>
     </div>
     <div class="fauthor">{{AUTHOR}}</div>
   </div>
 </div>
</div></body></html>